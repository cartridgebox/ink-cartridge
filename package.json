{
    "name": "ink-cartridge",
    "version": "5.5.0",
    "description": "Enhances Ink without replacing it — foundational screen management and layered keyboard engine for building interaction-dense terminal UIs.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/BAIGAOa/ink-cartridge.git"
    },
    "scripts": {
        "build": "npm run build -w @cartridge-engine/keyboard-engine && tsc --locale zh-CN && npm run build -w @cartridge-engine/i18n -w @cartridge-engine/theme -w @cartridge-engine/event -w @cartridge-engine/init",
        "watch": "tsc --watch --locale zh-CN",
        "clean": "rm -rf dist",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "npx vitest run --coverage",
        "bench": "vitest bench --config vitest.bench.config.ts",
        "lint": "eslint src/ packages/",
        "lint:fix": "eslint --fix src/ packages/",
        "lint:quick": "eslint src/ packages/ --quiet --cache",
        "docs": "npm run docs:framework && npm run docs:engine && npm run docs:i18n && npm run docs:theme && npm run docs:event",
        "docs:framework": "typedoc --options typedoc.json",
        "docs:engine": "typedoc --options typedoc.engine.json",
        "docs:i18n": "typedoc --options typedoc.i18n.json",
        "docs:theme": "typedoc --options typedoc.theme.json",
        "docs:event": "typedoc --options typedoc.event.json"
    },
    "keywords": [
        "ink",
        "ink-component",
        "react",
        "tui",
        "cli",
        "terminal",
        "screen-management"
    ],
    "author": "BAIGAO",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "peerDependencies": {
        "ink": ">=5",
        "react": ">=18"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@eslint/js": "^9.39.4",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^20.19.39",
        "@types/react": "^19.2.14",
        "@typescript-eslint/eslint-plugin": "^8.62.0",
        "@typescript-eslint/parser": "^8.62.0",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^9.39.4",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "ink": "^7.1.1",
        "ink-testing-library": "^4.0.0",
        "jsdom": "^26.0.0",
        "react": "^19.2.4",
        "tsx": "^4.22.4",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.62.0",
        "vitest": "^4.1.5"
    },
    "bugs": {
        "url": "https://github.com/BAIGAOa/ink-cartridge/issues"
    },
    "homepage": "https://github.com/BAIGAOa/ink-cartridge#readme",
    "workspaces": [
        ".",
        "src/keyboard-engine",
        "packages/*"
    ],
    "dependencies": {
        "@cartridge-engine/keyboard-engine": "*"
    }
}
